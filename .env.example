# Postgres connection string — matches docker-compose.yml (Postgres 16)
DATABASE_URL=postgres://studio:studio@127.0.0.1:5432/studio

# Used to encrypt JWT tokens — generate with: openssl rand -hex 24
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin of this Payload app. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Authenticates cron jobs — generate with: openssl rand -hex 24
CRON_SECRET=YOUR_SECRET_HERE

# Validates live-preview / draft-preview requests — generate with: openssl rand -hex 24
PREVIEW_SECRET=YOUR_SECRET_HERE

# ─── Publish pipeline (step 9) ───────────────────────────────────────────────

# BullMQ backing store (docker-compose maps host 6380 -> container 6379)
REDIS_URL=redis://127.0.0.1:6380

# Object storage for published envelopes + versioned asset bundles.
# Local MinIO stands in for Cloudflare R2; swap for real R2 endpoint + creds.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=studio
S3_SECRET_ACCESS_KEY=studio-secret
S3_BUCKET=studio-render
S3_FORCE_PATH_STYLE=true

# Public base URL the bucket/CDN is served from. No trailing slash.
S3_PUBLIC_URL=http://127.0.0.1:9000/studio-render
RENDER_ASSET_BASE_URL=http://127.0.0.1:9000/studio-render

# CDN cache purge: none | cloudflare
CDN_PURGE_PROVIDER=none
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Consumers to notify on publish (comma-separated absolute URLs). Empty = none.
CONSUMER_WEBHOOK_URLS=
# HMAC-SHA256 secret for the x-studio-signature header on webhook calls
CONSUMER_WEBHOOK_SECRET=YOUR_SECRET_HERE
