# Postgres connection string — matches docker-compose.yml (Postgres 16)
DATABASE_URL=postgres://studio:studio@127.0.0.1:5432/studio

# Used to encrypt JWT tokens — generate with: openssl rand -hex 24
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin of this Payload app. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Authenticates cron jobs — generate with: openssl rand -hex 24
CRON_SECRET=YOUR_SECRET_HERE

# Validates live-preview / draft-preview requests — generate with: openssl rand -hex 24
PREVIEW_SECRET=YOUR_SECRET_HERE
